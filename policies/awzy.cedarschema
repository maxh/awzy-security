// Principals, from the world model (awzy-context, fed by connectors).

// IdP groups and teams; groups can nest.
entity Group in [Group];

// A person. `active` comes from the IdP through awzy-context; absent when an enforcement point
// built the entity from a token alone.
entity Human in [Group] {
  active?: Bool,
};

// Any non-human identity with its own credentials: a backend service, a scheduled job, an
// AI agent. When it acts for a person, the request names that person (context.on_behalf_of).
entity ServiceAccount in [Group] {
  // Accountable for it: receives its challenges and alerts.
  owner: Human,
  // An AI agent rather than conventional software.
  ai: Bool,
};

// Resources form a hierarchy (folders, projects).
entity Resource in [Resource] {
  // public | internal | confidential | crown_jewels
  sensitivity: String,
  // Set by the PDP: true when no label or classifier has set `sensitivity`, so it's the default
  // tier, including for a resource awzy-context doesn't know yet. Policies can challenge these.
  unclassified?: Bool,
  // Who owns it in its source system (ADR 0061). Owners approve access to it.
  owner?: Human,
  // Who it's shared with, including through its folders (ADR 0061): the people and groups who can
  // at least read it, those who can also change it, and whether everyone in the organization can.
  shared_humans?: Set<Human>,
  shared_groups?: Set<Group>,
  writer_humans?: Set<Human>,
  writer_groups?: Set<Group>,
  shared_with_everyone?: Bool,
};

// An MCP server behind awzy-gateway, and its tools (`<server>/<tool>`).
entity McpServer;
entity McpTool in [McpServer] {
  // Set per tool in the gateway's config until awzy-context classifies tools. A high-risk
  // operation (resetting credentials, exporting the directory) is "crown_jewels".
  sensitivity: String,
};

// An area of the client portal and its MCP server: "decisions", "policies", "enforcement",
// "directory", "challenges", or "investigations" (ADR 0020).
entity PortalArea {
  // Set by the portal; "confidential" for every area.
  sensitivity: String,
};

// What every check carries. Shared by all actions.
type RequestContext = {
  // 0-100. Set by the PDP (0 until awzy-reasoner writes risk attributes).
  risk_score: Long,
  // Set by the PDP from the request, never by the caller. The human a service account is
  // acting for (OAuth token exchange, RFC 8693); absent when it acts on its own authority.
  on_behalf_of?: Human,
  // Set by the PDP: whether a person is there to answer a challenge right now.
  human_present: Bool,
  // Set by the PDP for a Resource when awzy-context is in use: whether this check's principal is
  // assigned to open work (a ticket, account, project, or statement of work) that links the
  // resource or a folder above it (ADR 0046). Absent when awzy doesn't know, so test it with
  // `context has assigned`.
  assigned?: Bool,
  // What the enforcement point observed about the calling software, e.g. "browser", "cli",
  // or "mcp" (awzy-gateway). A Human arriving through "mcp" is software holding a person's own
  // token.
  client?: String,
  // Set by the PDP: for a person, 0-100, how much their requests look like software using their
  // credentials (awzy-reasoner, ADR 0085). Absent until scored, so test it with `has`.
  automation_score?: Long,
  // The MCP client's name, as its session's `initialize` gave it (awzy-gateway), e.g.
  // "claude-code". What the client says it is: a hint, not proof.
  mcp_client?: String,
  // Set by awzy-challenge on an `approve` check: the person who answers for the challenged
  // request (the human asking, the person an agent acts for, or an unattended account's owner).
  // A service account never approves for its own owner (ADR 0065).
  approving_for?: Human,
  // Set by the client portal for an awzy staff member in a support session (ADR 0095): the portal
  // areas a client admin approved. Present only on that staff member's checks.
  support_areas?: Set<PortalArea>,
};

action read, write appliesTo {
  principal: [Human, ServiceAccount],
  resource: [Resource],
  context: RequestContext,
};

// Calling an MCP tool through awzy-gateway.
action call appliesTo {
  principal: [Human, ServiceAccount],
  resource: [McpTool],
  context: RequestContext,
};

// Using the client portal or its MCP server: reading an area, or changing what it controls
// (publishing policy, switching enforcement).
action view, administer appliesTo {
  principal: [Human, ServiceAccount],
  resource: [PortalArea],
  context: RequestContext,
};

// Switching an enforcement mode, either way, on top of `administer` on the enforcement area:
// asked only when someone switches, so policy can challenge the switch itself.
action switch_enforcement appliesTo {
  principal: [Human, ServiceAccount],
  resource: [PortalArea],
  context: RequestContext,
};

// Approving someone else's challenged request for this resource (awzy-challenge). awzy-challenge
// asks the PDP before recording an approval, and never accepts one from the person asking or the
// person an agent acts for. A service account, such as an overseer agent, approves only where a
// policy lets it (ADR 0065).
action approve appliesTo {
  principal: [Human, ServiceAccount],
  resource: [Resource, McpTool, PortalArea],
  context: RequestContext,
};
