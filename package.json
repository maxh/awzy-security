{
  "name": "awzy",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "sh tools/git-setup || true",
    "relay": "pnpm --filter './portals/*/frontend' relay",
    "lint": "pnpm relay && oxlint --type-aware --deny-warnings portals authz/sdks && node tools/ci/check-graphql-schemas.mjs && node tools/ci/check-proto-qids.mjs",
    "format": "oxfmt 'portals/**/*.{ts,tsx,js,mjs}' 'authz/sdks/**/*.ts'",
    "format:check": "oxfmt --check 'portals/**/*.{ts,tsx,js,mjs}' 'authz/sdks/**/*.ts'"
  },
  "devDependencies": {
    "graphql": "^17.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "packageExtensions": {
      "babel-plugin-relay": {
        "dependencies": {
          "@babel/runtime": "^7.28.0"
        }
      },
      "@tabler/icons-react": {
        "peerDependencies": {
          "@types/react": "^19.0.0"
        }
      },
      "@mantine/hooks": {
        "peerDependencies": {
          "react-dom": "^19.2.0"
        }
      }
    }
  }
}
