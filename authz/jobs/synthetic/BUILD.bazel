load("//tools:rust.bzl", "awzy_service")

# The synthetic company the demo, local development, scenario tests, and scale tests run on
# (docs/demo-plan.md, ADR 0039). Sends it to awzy-context through the same APIs an IdP and the
# connectors use.
awzy_service(
    name = "synthetic",
    crate_name = "awzy_synthetic",
    binary_name = "awzy-synthetic",
    visibility = ["//tools:client_side"],
    deps = [
        "//authz/libs/service-auth",
        "//libs/telemetry",
    ],
    # The tests score awzy-classify against the generator's ground truth (ADR 0047), and run the
    # scenarios end to end through awzy-context, the PDP, and awzy-gateway.
    test_deps = [
        "//authz/libs/classify",
        "//authz/libs/proto",
        "//authz/services/context",
        "//authz/services/gateway",
        "//authz/services/pdp",
        "//libs/model",
    ],
)
