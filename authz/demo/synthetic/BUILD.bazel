load("//tools:rust.bzl", "awzy_service")

# The synthetic company the demo, local development, scenario tests, and scale tests run on
# (docs/plans/demo-plan.md, ADR 0039). Demo-only: nothing outside authz/demo may depend on it (ADR 0063). Sends it to awzy-context through the same APIs an IdP and the
# connectors use.
awzy_service(
    name = "synthetic",
    crate_name = "awzy_synthetic",
    binary_name = "awzy-synthetic",
    # Medium: the scenario test loads all of Larkspur into awzy-context and runs it through the PDP
    # and awzy-gateway, which takes longer than a minute when the whole suite runs at once.
    test_size = "medium",
    visibility = ["//tools:demo_only"],
    deps = [
        "//authz/libs/service-auth",
        "//libs/server",
        "//libs/telemetry",
        "//tools/dev-idp",
    ],
    # The tests score awzy-classify against the generator's ground truth (ADR 0047), and run the
    # scenarios end to end through awzy-context, the PDP, awzy-challenge, and awzy-gateway, with
    # awzy-reasoner's scores and containments.
    test_deps = [
        "//authz/libs/classify",
        "//authz/libs/proto",
        "//authz/services/challenge",
        "//authz/services/context",
        "//authz/services/gateway",
        "//authz/services/pdp",
        "//authz/services/reasoner",
        "//libs/model",
    ],
)
