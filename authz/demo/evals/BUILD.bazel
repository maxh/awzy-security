load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//tools:rust.bzl", "awzy_rust_library")

# The investigation evals (ADR 0067), with the synthetic company's ground truth. The tests run
# every case against a model that obeys every injection; `bazel run :awzy-evals` runs them against
# Bedrock. A command, not a service: no image.
awzy_rust_library(
    name = "evals",
    crate_name = "awzy_evals",
    visibility = ["//tools:demo_only"],
    deps = [
        "//authz/demo/synthetic",
        "//authz/services/reasoner",
        "//libs/llm",
    ],
)

rust_binary(
    name = "awzy-evals",
    srcs = ["src/main.rs"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools:demo_only"],
    deps = [
        ":evals",
        "//libs/llm",
    ] + all_crate_deps(normal = True),
)
