load("//tools:rust.bzl", "awzy_service")

awzy_service(
    name = "challenge",
    crate_name = "awzy_challenge",
    binary_name = "awzy-challenge",
    # Embedded by sqlx::migrate!.
    # The tests check every method in challenge.proto has an access rule.
    # events.p: a test holds the model's log lines to the events the model declares (ADR 0130).
    compile_data = glob(["migrations/*.sql"]) + ["src/feed/events.p", "//authz/libs/proto:protos"],
    visibility = ["//tools:client_side"],
    deps = [
        "//authz/libs/context-api",
        "//libs/http",
        "//authz/libs/proto",
        "//authz/libs/service-auth",
        "//libs/migrations",
        "//libs/model",
        "//libs/server",
        "//libs/telemetry",
    ],
    test_deps = ["//authz/services/pdp"],
)
