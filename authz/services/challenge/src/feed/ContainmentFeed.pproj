<!-- The containment feed's P model (ADR 0126). Each machine sits beside the Rust it models. -->
<Project>
  <ProjectName>ContainmentFeed</ProjectName>
  <InputFiles>
    <PFile>./events.p</PFile>
    <PFile>./timings.p</PFile>
    <PFile>./specs.p</PFile>
    <PFile>./test.p</PFile>
    <PFile>../store.p</PFile>
    <PFile>../feed.p</PFile>
    <PFile>../../../pdp/src/containments.p</PFile>
    <PFile>../../../gateway/src/containments.p</PFile>
  </InputFiles>
  <OutputDir>./PGenerated/</OutputDir>
</Project>
