load("//tools:rust.bzl", "awzy_service")

awzy_service(
    name = "policy",
    crate_name = "awzy_policy",
    binary_name = "awzy-policy",
    extra_binaries = [
        "awzy-break-glass",
        "awzy-publish",
    ],
    # An admin runs break-glass in awzy-policy's pod (kubectl exec), so it ships with it.
    image_binaries = ["awzy-break-glass"],
    # Embedded by sqlx::migrate!.
    compile_data = glob(["migrations/*.sql"]),
    visibility = ["//tools:client_side"],
    deps = [
        "//authz/libs/proto",
        "//authz/libs/service-auth",
        "//authz/libs/signing",
        "//authz/libs/signing-aws",
        "//authz/services/pdp",
        "//libs/migrations",
        "//libs/model",
        "//libs/server",
        "//libs/store",
        "//libs/telemetry",
    ],
)
