load("//tools:rust.bzl", "awzy_service")

awzy_service(
    name = "policy",
    crate_name = "awzy_policy",
    binary_name = "awzy-policy",
    extra_binaries = [
        "awzy-break-glass",
        "awzy-publish",
    ],
    # Embedded by sqlx::migrate!.
    compile_data = glob(["migrations/*.sql"]),
    visibility = ["//tools:client_side"],
    deps = [
        "//authz/services/pdp",
        "//authz/libs/proto",
        "//authz/libs/signing",
        "//libs/model",
        "//libs/server",
        "//libs/telemetry",
    ],
)
