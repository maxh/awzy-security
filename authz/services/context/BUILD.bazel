load("//tools:rust.bzl", "awzy_service")

awzy_service(
    name = "context",
    crate_name = "awzy_context",
    binary_name = "awzy-context",
    # Embedded by sqlx::migrate!.
    compile_data = glob(["migrations/*.sql"]),
    visibility = ["//tools:client_side"],
    deps = [
        "//authz/libs/classify",
        "//authz/libs/service-auth",
        "//libs/migrations",
        "//libs/model",
        "//libs/server",
        "//libs/store",
        "//libs/telemetry",
    ],
)
