load("//tools:rust.bzl", "awzy_service")

awzy_service(
    name = "pdp",
    crate_name = "awzy_pdp",
    binary_name = "awzy-pdp",
    extra_binaries = [
        "pdp_bench",
        "pdp_freshness",
        "pdp_loadtest",
    ],
    # The load test runs in the cluster from the published image, so it measures what ships (#94).
    image_binaries = ["pdp_loadtest"],
    # Over a hundred tests, including the plan's randomized ones, come close to a minute on a
    # busy CI runner, and timed out there twice.
    test_size = "medium",
    deps = [
        "//libs/http",
        "//authz/libs/kafka",
        "//libs/server",
        "//libs/telemetry",
        "//libs/model",
        "//authz/libs/proto",
        "//authz/libs/service-auth",
        "//authz/libs/signing",
    ],
    compile_data = [
        "//policies:cedar",
    ],
    visibility = ["//tools:client_side"],
)
