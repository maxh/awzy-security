<!-- A resource's attributes reaching the PDPs (ADR 0126). Each machine sits beside the Rust it models. -->
<Project>
  <ProjectName>ResourceCache</ProjectName>
  <InputFiles>
    <PFile>./events.p</PFile>
    <PFile>./timings.p</PFile>
    <PFile>./specs.p</PFile>
    <PFile>./test.p</PFile>
    <PFile>../resources.p</PFile>
    <PFile>../../../context/src/resources.p</PFile>
  </InputFiles>
  <OutputDir>./PGenerated/</OutputDir>
</Project>
