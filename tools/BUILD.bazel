# Code that runs in client clusters and may touch client data.
# portals/corp is deliberately not in this group, so Bazel refuses to build
# portals/corp code that depends on authz services or the data-store library.
package_group(
    name = "client_side",
    packages = [
        "//authz/...",
        "//portals/client/...",
        "//libs/...",
        "//policies/...",
    ],
)

# Demo-only code (ADR 0063): the synthetic company and its stand-in servers. Visible only to
# itself, so no service, job, or library can depend on it and carry it into a real install.
package_group(
    name = "demo_only",
    packages = ["//authz/demo/..."],
)
