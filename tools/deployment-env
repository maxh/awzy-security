#!/usr/bin/env bash
# Backs up a deployment's deployment.env to AWS Secrets Manager, and restores it. Keeps a copy on
# this machine too.
#
# deployment.env is gitignored (ADR 0053) and is the only record of which accounts, buckets,
# and names a deployment's Terraform targets. The backup lives in that deployment's own
# management account, as the secret awzy/deployment-env/<deployment>. A GCP deployment (its file
# sets TF_VAR_project) is backed up in its project's Secret Manager instead, as
# awzy-deployment-env-<deployment>. Each push, and `local`, also copies it to
# $AWZY_DEPLOYMENT_ENV_DIR (default ~/backup/awzy/deployment-env) as <deployment>.env, readable
# only by you, for when the checkout is gone and the cloud session has expired.
#
#   tools/deployment-env push corp
#   tools/deployment-env local corp
#   tools/deployment-env pull corp --profile awzy-corp --region us-east-2
#   tools/deployment-env pull example-client-gcp --project <project id>
#   tools/deployment-env pull corp --local
#
# A deployment is a folder with a deployment.env: deploy/terraform/<name> or
# deploy/terraform/examples/<name>. `push` reads the profile and region from the file; `pull`
# needs them given, since the file doesn't exist yet. `pull` won't replace a local file that
# differs unless given --force.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

main() {
  local action=${1:-} deployment=${2:-}
  [ -n "$action" ] && [ -n "$deployment" ] || usage
  shift 2
  local dir file
  dir=$(find_deployment "$deployment")
  file="$dir/deployment.env"
  case "$action" in
    push) push "$deployment" "$file" && save_local "$deployment" "$file" ;;
    local) save_local "$deployment" "$file" ;;
    pull) pull "$deployment" "$file" "$@" ;;
    *) usage ;;
  esac
}

usage() {
  echo "usage: tools/deployment-env push <deployment>" >&2
  echo "       tools/deployment-env local <deployment>" >&2
  echo "       tools/deployment-env pull <deployment> --profile <aws profile> --region <region> [--force]" >&2
  echo "       tools/deployment-env pull <deployment> --project <gcp project> [--force]" >&2
  echo "       tools/deployment-env pull <deployment> --local [--force]" >&2
  exit 2
}

find_deployment() {
  for dir in "deploy/terraform/$1" "deploy/terraform/examples/$1"; do
    if [ -f "$dir/deployment.env.example" ]; then
      echo "$dir"
      return
    fi
  done
  echo "no deployment named $1 (looked for deploy/terraform/$1 and deploy/terraform/examples/$1)" >&2
  exit 2
}

secret_name() {
  echo "awzy/deployment-env/$1"
}

# This machine's copy of a deployment's file.
local_copy() {
  echo "${AWZY_DEPLOYMENT_ENV_DIR:-$HOME/backup/awzy/deployment-env}/$1.env"
}

save_local() {
  local deployment=$1 file=$2 copy
  [ -f "$file" ] || { echo "no $file to copy" >&2; exit 1; }
  copy=$(local_copy "$deployment")
  (umask 077 && mkdir -p "$(dirname "$copy")" && cp "$file" "$copy")
  echo "copied $file to $copy"
}

# Secret Manager names can't hold a slash.
gcp_secret_name() {
  echo "awzy-deployment-env-$1"
}

# The value of TF_VAR_<name> in a deployment.env, without quotes.
setting() {
  sed -n "s/^export TF_VAR_$2=//p" "$1" | tr -d "'\""
}

push() {
  local deployment=$1 file=$2
  [ -f "$file" ] || { echo "no $file to back up" >&2; exit 1; }
  local project
  project=$(setting "$file" project)
  if [ -n "$project" ]; then
    push_gcp "$deployment" "$file" "$project"
    return
  fi
  local profile region account
  profile=$(setting "$file" management_profile)
  region=$(setting "$file" region)
  account=$(aws sts get-caller-identity --profile "$profile" --region "$region" --query Account --output text)

  # Only ever store it in the management account the file itself names.
  if [ "$account" != "$(setting "$file" management_account_id)" ]; then
    echo "profile $profile is account $account, not this deployment's management account" >&2
    exit 1
  fi

  local name aws=(aws --profile "$profile" --region "$region" secretsmanager)
  name=$(secret_name "$deployment")
  if "${aws[@]}" describe-secret --secret-id "$name" >/dev/null 2>&1; then
    "${aws[@]}" put-secret-value --secret-id "$name" --secret-string "file://$file" >/dev/null
  else
    "${aws[@]}" create-secret --name "$name" --secret-string "file://$file" \
      --description "deployment.env for the $deployment deployment (tools/deployment-env)" >/dev/null
  fi
  echo "backed up $file to $name in account $account"
}

# Only ever stored in the project the file itself names.
push_gcp() {
  local deployment=$1 file=$2 project=$3 name
  name=$(gcp_secret_name "$deployment")
  if gcloud secrets describe "$name" --project "$project" >/dev/null 2>&1; then
    gcloud secrets versions add "$name" --project "$project" --data-file "$file" >/dev/null
  else
    gcloud secrets create "$name" --project "$project" --replication-policy automatic --data-file "$file" \
      --labels purpose=deployment-env >/dev/null
  fi
  echo "backed up $file to $name in project $project"
}

pull() {
  local deployment=$1 file=$2
  shift 2
  local profile="" region="" project="" from_local=false force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile=$2; shift 2 ;;
      --project) project=$2; shift 2 ;;
      --region) region=$2; shift 2 ;;
      --local) from_local=true; shift ;;
      --force) force=true; shift ;;
      *) usage ;;
    esac
  done
  $from_local || [ -n "$project" ] || { [ -n "$profile" ] && [ -n "$region" ]; } || usage

  local name
  backup=$(mktemp)
  trap 'rm -f "$backup"' EXIT
  if $from_local; then
    name=$(local_copy "$deployment")
    [ -f "$name" ] || { echo "no local copy at $name" >&2; exit 1; }
    cp "$name" "$backup"
  elif [ -n "$project" ]; then
    name=$(gcp_secret_name "$deployment")
    gcloud secrets versions access latest --secret "$name" --project "$project" > "$backup"
  else
    name=$(secret_name "$deployment")
    # JSON rather than text: --output text adds a newline the file doesn't have.
    aws --profile "$profile" --region "$region" secretsmanager get-secret-value --secret-id "$name" \
      --query SecretString --output json | python3 -c 'import json, sys; sys.stdout.write(json.load(sys.stdin))' > "$backup"
  fi

  if [ -f "$file" ] && ! cmp -s "$backup" "$file" && ! $force; then
    diff -u "$file" "$backup" >&2 || true
    echo "$file differs from the backup (above); rerun with --force to replace it" >&2
    exit 1
  fi
  (umask 077 && cp "$backup" "$file")
  echo "restored $file from $name"
}

main "$@"
