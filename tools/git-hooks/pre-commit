#!/bin/sh
# Refuses a commit whose staged Rust or TypeScript isn't formatted, or whose TypeScript fails
# oxlint's quick (not type-aware) rules. Install once per clone (it applies to every worktree):
#
#   git config core.hooksPath tools/git-hooks
#
# Checks the staged content, not the working tree. Clippy and type-aware oxlint need a full
# build or type information, so they're left to CI (`bazel build --config=lint //...`,
# `pnpm lint`).
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# ---- Lockfiles: a merge or rebase that stopped on another conflict never ran the re-pin
# (tools/git-merge-lockfile left a marker); do it now and include them in this commit.
if [ -f "$(git rev-parse --git-dir)/awzy-repin-needed" ] && [ -z "${AWZY_REPINNED:-}" ]; then
  "$root/tools/git-hooks/repin-if-needed" --stage
fi
failed=""
staged=$(mktemp -d)  # staged copies of the files being checked
trap 'rm -rf "$staged"' EXIT

# ---- Identifiers: nothing that names a real account, deployment, or person
# (.agents/skills/keep-deployments-out).

if ! tools/ci/check-identifiers.sh --staged >/dev/null; then
  failed="$failed  (identifiers found above; use placeholders)
"
fi

# ---- Rust: rustfmt (rustfmt.toml)

rust_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
if [ -n "$rust_files" ]; then
  if command -v rustfmt >/dev/null 2>&1; then
    rustfmt=rustfmt
  else
    bazel=$(command -v bazel || command -v bazelisk || true)
    if [ -z "$bazel" ]; then
      echo "pre-commit: neither rustfmt nor bazel is on PATH, so Rust formatting can't be checked." >&2
      echo "Install bazelisk (see DEVELOPMENT.md), or commit with --no-verify." >&2
      exit 1
    fi
    # A script that runs this worktree's toolchain rustfmt without going through Bazel each
    # time. Rebuilt when the toolchain may have changed or the script stops working.
    rustfmt="$(cd "$(git rev-parse --git-dir)" && pwd)/awzy-rustfmt.sh"
    if [ ! -x "$rustfmt" ] || [ MODULE.bazel.lock -nt "$rustfmt" ] || ! "$rustfmt" --version >/dev/null 2>&1; then
      "$bazel" run --noshow_progress --ui_event_filters=-info \
        --script_path="$rustfmt" @rules_rust//tools/upstream_wrapper:rustfmt >&2
    fi
  fi
  # rustfmt --check exits 0 for stdin even when it prints a diff, so compare its output.
  for f in $rust_files; do
    git show ":$f" >"$staged/.rustfmt-input"
    if ! "$rustfmt" --emit stdout --config-path rustfmt.toml <"$staged/.rustfmt-input" 2>/dev/null | cmp -s - "$staged/.rustfmt-input"; then
      failed="$failed  $f (rustfmt; tools/fmt formats it)
"
    fi
  done
fi

# ---- TypeScript: oxfmt (.oxfmtrc.json) and oxlint (.oxlintrc.json)

ts_files=$(git diff --cached --name-only --diff-filter=ACMR -- \
  'portals/*.ts' 'portals/*.tsx' 'portals/*.js' 'portals/*.mjs' | grep -v '/__generated__/' || true)
if [ -n "$ts_files" ]; then
  if [ ! -x node_modules/.bin/oxfmt ] || [ ! -x node_modules/.bin/oxlint ]; then
    echo "pre-commit: oxfmt and oxlint aren't installed; run \`pnpm install\` (or commit with --no-verify)." >&2
    exit 1
  fi
  for f in $ts_files; do
    mkdir -p "$staged/$(dirname "$f")"
    git show ":$f" >"$staged/$f"
    if ! node_modules/.bin/oxfmt --stdin-filepath "$f" <"$staged/$f" | cmp -s - "$staged/$f"; then
      failed="$failed  $f (oxfmt; tools/fmt formats it)
"
    fi
  done
  if ! (cd "$staged" && "$root/node_modules/.bin/oxlint" -c "$root/.oxlintrc.json" --deny-warnings $ts_files) >&2; then
    failed="$failed  (oxlint findings above)
"
  fi
fi

if [ -n "$failed" ]; then
  echo "pre-commit: fix these, stage the changes, and commit again:" >&2
  printf '%s' "$failed" >&2
  exit 1
fi
