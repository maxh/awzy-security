#!/usr/bin/env bash
# awzy on your machine, with Larkspur Capital, the demo's synthetic company: its people, agents,
# documents, and a day of their work flowing through the MCP gateway as PDP decisions.
#
#   tools/demo up      # build, start everything, seed the company, print where to sign in
#   tools/demo check   # is every part answering? (what CI runs)
#   tools/demo partner # an app's own agent, end to end: trusted, registered, checked, planned
#   tools/demo down    # stop it; `down --wipe` also removes the local stack's data
#   tools/demo logs    # where each service's log is
#
# Needs Docker and Bazel (bazelisk); Bazel fetches Rust and Node itself. The first build takes a
# while. Everything listens on 127.0.0.1 only. The sign-in is the development IdP's: no
# passwords, a fixed key, sample people. Never expose it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

state=.demo
mkdir -p "$state/logs"
compose=(docker compose -f deploy/local/compose.yaml)

POLICY=8081 PDP=8082 CHALLENGE=8083 CONTEXT=8084 INTAKE=8085 GATEWAY=8086 PORTAL=8080 IDP=5556 DRIVE=8095
pg=postgres://awzy:awzy@localhost:5432
clickhouse=(AWZY_CLICKHOUSE_URL=http://localhost:8123 AWZY_CLICKHOUSE_USER=awzy AWZY_CLICKHOUSE_PASSWORD=awzy
  AWZY_CLICKHOUSE_DATABASE=awzy)
# awzy-context wants at least 32 characters.
scim_token=demo-scim-token-for-the-local-demo-only
gateway_secret=demo-gateway-secret
# awzy-intake wants at least 32 characters too.
intake_token=demo-intake-token-for-the-local-demo-only

targets=(
  //authz/jobs/clickhouse-migrate:awzy-clickhouse-migrate
  //authz/services/policy:awzy-policy
  //authz/services/policy:awzy-publish
  //authz/services/pdp:awzy-pdp
  //authz/services/context:awzy-context
  //authz/services/challenge:awzy-challenge
  //authz/services/gateway:awzy-gateway
  //authz/services/intake:awzy-intake
  //authz/demo/synthetic:awzy-synthetic
  //portals/client/backend:awzy-client-portal
  //portals/client/frontend:build
  //tools/dev-idp:awzy-dev-idp
)

# Who each part runs as, as the chart's service accounts name them (ADR 0055).
backend=awzy-system/awzy
portal_sa=awzy-portal/awzy
policy_sa=awzy-system/awzy-policy
demo_data=awzy-system/awzy-demo-data

# Service auth is on, as in an install: the dev IdP mints each service account's tokens, one per
# service it calls, and every service checks the tokens it's sent against the dev IdP's keys.
mint_tokens() {
  local who aud dir
  for who in $backend $portal_sa $policy_sa $demo_data; do
    dir="$state/tokens/$who"
    mkdir -p "$dir"
    for aud in awzy-policy awzy-context awzy-challenge awzy-pdp; do
      curl -sf --cacert "$state/idp-ca.pem" "https://127.0.0.1:$IDP/service-token" -H 'content-type: application/json' \
        -d "{\"namespace\": \"${who%/*}\", \"service_account\": \"${who#*/}\", \"audience\": \"$aud\"}" |
        sed -nE 's/.*"token": ?"([^"]+)".*/\1/p' >"$dir/$aud"
    done
  done
}

# The settings that turn service auth on for something running as service account `$1`.
auth() {
  echo AWZY_SERVICE_AUTH=on AWZY_SERVICE_AUTH_JWKS_URL=https://127.0.0.1:$IDP/jwks \
    AWZY_SERVICE_AUTH_ISSUER=https://127.0.0.1:$IDP/service-accounts \
    AWZY_SERVICE_AUTH_CA_FILE="$PWD/$state/idp-ca.pem" AWZY_SERVICE_TOKEN_DIR="$PWD/$state/tokens/$1"
}

# An Authorization header with service account `$1`'s token for `$2`, for calls the script makes.
bearer() { echo "authorization: Bearer $(cat "$state/tokens/$1/$2")"; }

log() { printf '\033[1m%s\033[0m %s\n' "demo:" "$*"; }

# The built output of a target, as an absolute path.
out() { echo "$PWD/$(bazel cquery --output=files "$1" 2>/dev/null | head -1)"; }

# Runs `command…` in the background as `name`, logging to .demo/logs/<name>.log.
start() {
  local name=$1
  shift
  env AWZY_LOG_FORMAT=json "$@" >"$state/logs/$name.log" 2>&1 &
  echo $! >"$state/$name.pid"
}

# Waits up to two minutes for `url` to answer 200.
wait_for() {
  local url=$1 what=$2
  for _ in $(seq 1 120); do
    if curl -skf -o /dev/null "$url"; then return 0; fi
    sleep 1
  done
  echo "demo: $what didn't come up; see $state/logs" >&2
  return 1
}

up() {
  command -v docker >/dev/null || { echo "demo: needs Docker" >&2; exit 1; }
  command -v bazel >/dev/null || { echo "demo: needs Bazel (bazelisk)" >&2; exit 1; }
  down >/dev/null 2>&1 || true

  log "starting Postgres, Kafka, ClickHouse, and Valkey"
  "${compose[@]}" up -d --wait

  log "building (the first time takes a while)"
  bazel build "${targets[@]}"
  migrate=$(out //authz/jobs/clickhouse-migrate:awzy-clickhouse-migrate)
  policy=$(out //authz/services/policy:awzy-policy)
  publish=$(out //authz/services/policy:awzy-publish)
  pdp=$(out //authz/services/pdp:awzy-pdp)
  context=$(out //authz/services/context:awzy-context)
  challenge=$(out //authz/services/challenge:awzy-challenge)
  gateway=$(out //authz/services/gateway:awzy-gateway)
  intake=$(out //authz/services/intake:awzy-intake)
  synthetic=$(out //authz/demo/synthetic:awzy-synthetic)
  portal=$(out //portals/client/backend:awzy-client-portal)
  frontend=$(out //portals/client/frontend:build)
  idp=$(out //tools/dev-idp:awzy-dev-idp)

  log "the dev IdP, and service tokens from it"
  start idp AWZY_LISTEN_ADDR=127.0.0.1:$IDP AWZY_DEV_IDP_CA_OUT="$PWD/$state/idp-ca.pem" "$idp"
  wait_for https://127.0.0.1:$IDP/.well-known/openid-configuration "the dev IdP"
  mint_tokens

  log "ClickHouse tables for the decision log"
  env "${clickhouse[@]}" AWZY_CLICKHOUSE_KAFKA_BROKERS=kafka:29092 "$migrate" >"$state/logs/clickhouse-migrate.log" 2>&1

  log "awzy-policy, with the base policies published"
  # shellcheck disable=SC2046 # auth's settings are separate words
  start policy $(auth $policy_sa) AWZY_LISTEN_ADDR=127.0.0.1:$POLICY AWZY_POSTGRES_URL=$pg/awzy_policy \
    AWZY_POLICY_READERS=$backend,$portal_sa,$demo_data AWZY_POLICY_WRITERS=$portal_sa,$demo_data "$policy"
  wait_for http://127.0.0.1:$POLICY/readyz awzy-policy
  # shellcheck disable=SC2046
  env $(auth $demo_data) "$publish" --endpoint http://127.0.0.1:$POLICY --by demo >"$state/logs/publish.log" 2>&1

  log "awzy-context, awzy-challenge, and the PDP"
  # shellcheck disable=SC2046
  start context $(auth $backend) AWZY_LISTEN_ADDR=127.0.0.1:$CONTEXT AWZY_POSTGRES_URL=$pg/awzy_context \
    AWZY_SCIM_TOKEN=$scim_token AWZY_CONTEXT_READERS=$backend,$portal_sa \
    AWZY_CONTEXT_TEAM_GROUPS="contractors-*,engineering-*,executive,finance,hr,it-admin,legal,sales-*,security,strategy,support" \
    AWZY_CONTEXT_WRITERS=$backend,$demo_data AWZY_CONTEXT_DIRECTORY=$backend,$portal_sa,$demo_data "$context"
  wait_for http://127.0.0.1:$CONTEXT/readyz awzy-context
  # shellcheck disable=SC2046
  start challenge $(auth $backend) AWZY_LISTEN_ADDR=127.0.0.1:$CHALLENGE AWZY_POSTGRES_URL=$pg/awzy_challenge \
    AWZY_PDP_ADDR=http://127.0.0.1:$PDP AWZY_CONTEXT_ADDR=http://127.0.0.1:$CONTEXT \
    AWZY_CHALLENGE_ANSWERERS=$portal_sa AWZY_CHALLENGE_CONTAINERS=$backend,$portal_sa \
    AWZY_CHALLENGE_PDPS=$backend AWZY_CHALLENGE_POLICY=$policy_sa "$challenge"
  # shellcheck disable=SC2046
  start pdp $(auth $backend) AWZY_LISTEN_ADDR=127.0.0.1:$PDP AWZY_POLICY_ADDR=http://127.0.0.1:$POLICY \
    AWZY_CONTEXT_ADDR=http://127.0.0.1:$CONTEXT AWZY_CHALLENGE_ADDR=http://127.0.0.1:$CHALLENGE \
    AWZY_KAFKA_BROKERS=localhost:9092 "$pdp"
  wait_for http://127.0.0.1:$CHALLENGE/readyz awzy-challenge
  wait_for http://127.0.0.1:$PDP/readyz awzy-pdp

  log "awzy-intake, for apps' activity"
  start intake AWZY_LISTEN_ADDR=127.0.0.1:$INTAKE AWZY_INTAKE_TOKEN=$intake_token AWZY_KAFKA_BROKERS=localhost:9092 "$intake"
  wait_for http://127.0.0.1:$INTAKE/readyz awzy-intake

  log "Larkspur Capital: its people, groups, agents, documents, and work"
  # shellcheck disable=SC2046
  env $(auth $demo_data) AWZY_CONTEXT_URL=http://127.0.0.1:$CONTEXT AWZY_SCIM_TOKEN=$scim_token \
    AWZY_POLICY_ADDR=http://127.0.0.1:$POLICY "$synthetic" all --profile demo --seed 1 \
    >"$state/logs/synthetic.log" 2>&1

  log "the client portal"
  # shellcheck disable=SC2046
  start portal $(auth $portal_sa) AWZY_LISTEN_ADDR=127.0.0.1:$PORTAL AWZY_POLICY_ADDR=http://127.0.0.1:$POLICY \
    AWZY_PDP_ADDR=http://127.0.0.1:$PDP AWZY_CONTEXT_ADDR=http://127.0.0.1:$CONTEXT \
    AWZY_CHALLENGE_ADDR=http://127.0.0.1:$CHALLENGE AWZY_SERVICE_ACCOUNT_REGISTRY=awzy-context \
    AWZY_AUTH_ISSUER=https://127.0.0.1:$IDP AWZY_AUTH_JWKS_URL=https://127.0.0.1:$IDP/jwks \
    AWZY_AUTH_CA_FILE="$PWD/$state/idp-ca.pem" AWZY_PORTAL_STATIC_DIR="$frontend" "${clickhouse[@]}" "$portal"
  wait_for http://127.0.0.1:$PORTAL/readyz "the client portal"

  log "the MCP gateway in front of larkspur-drive and larkspur-admin"
  cat >"$state/gateway.json" <<EOF
{
  "token": { "issuer": "https://idp.local", "audience": "awzy-gateway", "hs256_secret_env": "AWZY_GATEWAY_DEV_SECRET",
             "jwks_ca_file": "$PWD/$state/idp-ca.pem" },
  "service_account_registry": "awzy-context",
  "upstreams": [
    { "name": "larkspur-drive", "url": "http://127.0.0.1:$DRIVE/mcp",
      "resource_tools": { "read_document": { "argument": "id" }, "list_folder": { "argument": "id" } } },
    { "name": "larkspur-admin", "url": "http://127.0.0.1:$DRIVE/admin/mcp" }
  ],
  "outage": { "cached_allow_ttl_secs": 300 }
}
EOF
  # shellcheck disable=SC2046
  start drive $(auth $backend) AWZY_LISTEN_ADDR=127.0.0.1:$DRIVE AWZY_CONTEXT_URL=http://127.0.0.1:$CONTEXT "$synthetic" drive
  # shellcheck disable=SC2046
  start gateway $(auth $backend) AWZY_LISTEN_ADDR=127.0.0.1:$GATEWAY AWZY_GATEWAY_CONFIG="$PWD/$state/gateway.json" \
    AWZY_GATEWAY_DEV_SECRET=$gateway_secret AWZY_PDP_ADDR=http://127.0.0.1:$PDP \
    AWZY_POLICY_ADDR=http://127.0.0.1:$POLICY AWZY_CHALLENGE_ADDR=http://127.0.0.1:$CHALLENGE "$gateway"
  wait_for http://127.0.0.1:$DRIVE/readyz larkspur-drive
  wait_for http://127.0.0.1:$GATEWAY/readyz awzy-gateway

  log "a day of Larkspur's work through the gateway, in the background"
  # shellcheck disable=SC2046
  start activity $(auth $backend) AWZY_GATEWAY_URL=http://127.0.0.1:$GATEWAY AWZY_GATEWAY_DEV_SECRET=$gateway_secret \
    "$synthetic" activity --days 1 --rate 20

  cat <<EOF

  awzy is running. Open http://127.0.0.1:$PORTAL and sign in as alice (the security team).

  Your browser will warn about the sign-in page's certificate: the dev IdP made it for itself.
  Accept it once, or run \`mkcert -install\` and see DEVELOPMENT.md ("Local HTTPS") for one it trusts.

  - Decisions: every tool call Larkspur's people and agents make, decided per action. They
    arrive over the next few minutes, in monitor mode: would-deny and would-challenge, nothing blocked.
  - Directory and Look up: ~200 people, their teams, and four AI agents, from SCIM.
  - Enforcement: switch to enforce and watch challenges appear (it asks for a security key;
    Chrome's DevTools can add a virtual one).
  - Policies: the Cedar the decisions came from.

  tools/demo check   is everything answering?
  tools/demo down    stop it all
EOF
}

check() {
  local failed=0
  for svc in policy:$POLICY context:$CONTEXT challenge:$CHALLENGE pdp:$PDP intake:$INTAKE portal:$PORTAL drive:$DRIVE gateway:$GATEWAY; do
    if curl -sf -o /dev/null "http://127.0.0.1:${svc#*:}/readyz"; then echo "ok   ${svc%%:*}"; else echo "FAIL ${svc%%:*}"; failed=1; fi
  done
  if curl -skf -o /dev/null https://127.0.0.1:$IDP/.well-known/openid-configuration; then echo "ok   dev IdP"; else echo "FAIL dev IdP"; failed=1; fi
  # The portal tells the browser where to sign in.
  if curl -sf http://127.0.0.1:$PORTAL/auth/config | grep -q "127.0.0.1:$IDP"; then echo "ok   portal sign-in config"; else echo "FAIL portal sign-in config"; failed=1; fi
  # The company is in awzy-context, as SCIM wrote it.
  people=$(curl -sf "http://127.0.0.1:$CONTEXT/scim/v2/Users?count=1" -H "authorization: Bearer $scim_token" |
    sed -nE 's/.*"totalResults": ?([0-9]+).*/\1/p')
  if [ "${people:-0}" -gt 100 ]; then echo "ok   $people people provisioned"; else echo "FAIL people provisioned: ${people:-none}"; failed=1; fi
  # A decision about one of them.
  verdict=$(curl -sf http://127.0.0.1:$PDP/v1/access/evaluation -H "$(bearer $backend awzy-pdp)" \
    -H 'content-type: application/json' -d '{
    "principal": {"type": "Human", "id": "bob"}, "action": "read",
    "resource": {"type": "Resource", "id": "demo-check"}, "context": {},
    "entities": [{"uid": {"type": "Resource", "id": "demo-check"}, "attrs": {"sensitivity": "internal"}, "parents": []}]}' |
    sed -nE 's/.*"verdict": ?"([a-z]+)".*/\1/p')
  if [ -n "$verdict" ]; then echo "ok   the PDP decides ($verdict)"; else echo "FAIL the PDP decides"; failed=1; fi
  # Larkspur's activity reaches the decision log, through Kafka into ClickHouse: the Decisions page.
  decisions=0
  for _ in $(seq 1 90); do
    decisions=$(curl -sf "http://localhost:8123/?user=awzy&password=awzy" --data "SELECT count() FROM awzy.decisions" || echo 0)
    [ "${decisions:-0}" -gt 0 ] && break
    sleep 2
  done
  if [ "${decisions:-0}" -gt 0 ]; then echo "ok   $decisions decisions logged"; else echo "FAIL no decisions logged"; failed=1; fi
  # Service auth is on, as in an install: a call without a service token is refused.
  status=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$CONTEXT/v1/service-accounts")
  if [ "$status" = 401 ]; then echo "ok   service auth is on"; else echo "FAIL a call with no service token got $status"; failed=1; fi
  return $failed
}

# The design partner's path, end to end on the running demo: an app trusted to mint its own
# agents' tokens registers one, and that agent's calls are checked as it acting for its person.
partner() {
  local idp=https://127.0.0.1:$IDP app=acme-crm agent=acme-crm.renewals-bot failed=0 human
  local ca="$PWD/$state/idp-ca.pem"
  pass() { echo "ok   $*"; }
  fail() { echo "FAIL $*"; failed=1; }
  # A token the dev IdP signs as the app: for the app itself, or for one of its agents.
  app_token() { curl -sf --cacert "$ca" "$idp/apps/$app/token" -H 'content-type: application/json' -d "$1" |
    sed -nE 's/.*"access_token": ?"([^"]+)".*/\1/p'; }

  # Someone in Larkspur's directory owns the agent and is the person it acts for.
  human=$(curl -sf "http://127.0.0.1:$CONTEXT/v1/directory/humans?limit=1" -H "$(bearer $portal_sa awzy-context)" | grep -o '"user_name": *"[^"]*"' |
    head -1 | sed -E 's/.*"([^"]+)"$/\1/')
  if [ -n "$human" ]; then pass "$human from the directory owns the agent"; else fail "no one in the directory"; fi

  # An admin trusts the app (here straight in awzy-context; the portal's Directory page does it).
  if curl -sf -X PUT "http://127.0.0.1:$CONTEXT/v1/token-issuers/$app" -H 'content-type: application/json' \
    -H "$(bearer $portal_sa awzy-context)" \
    -H 'x-awzy-actor: Human::alice' \
    -d "{\"issuer\": \"$idp/apps/$app\", \"jwks_url\": \"$idp/apps/$app/jwks\", \"audience\": \"awzy-agents\"}" >/dev/null; then
    pass "$app trusted to sign its agents' tokens"
  else
    fail "trusting $app"
  fi

  # The app registers its agent with a token it signs for itself, once the portal has the list.
  local own registered=""
  own=$(app_token "{\"sub\": \"$app\"}")
  for _ in $(seq 1 30); do
    if curl -sf -X PUT "http://127.0.0.1:$PORTAL/api/v1/agents/$agent" -H "authorization: Bearer $own" \
      -H 'content-type: application/json' -d "{\"owner\": \"$human\", \"description\": \"Drafts renewals\"}" >/dev/null; then
      registered=yes
      break
    fi
    sleep 1
  done
  if [ -n "$registered" ]; then pass "$app registered $agent"; else fail "$app registering $agent"; fi
  # And can't register one outside its name.
  status=$(curl -s -o /dev/null -w '%{http_code}' -X PUT "http://127.0.0.1:$PORTAL/api/v1/agents/sales-genie" \
    -H "authorization: Bearer $own" -H 'content-type: application/json' -d "{\"owner\": \"$human\"}")
  if [ "$status" = 403 ]; then pass "$app can't register agents outside its name"; else fail "outside its name: $status"; fi

  # The agent, acting for that person, calls a tool through the gateway with the app's token.
  local token mcp
  token=$(app_token "{\"sub\": \"$human\", \"act\": \"$agent\"}")
  mcp() { curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$GATEWAY/mcp/larkspur-drive" -H "authorization: Bearer $1" \
    -H 'content-type: application/json' -H 'accept: application/json, text/event-stream' \
    -d '{"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "read_document", "arguments": {"id": "demo-check"}}}'; }
  local seen=""
  for _ in $(seq 1 30); do
    status=$(mcp "$token")
    if [ "$status" != 401 ]; then seen=$status; break; fi
    sleep 1
  done
  if [ -n "$seen" ]; then pass "the gateway takes $agent's app-signed token ($seen)"; else fail "the gateway refuses $agent's token"; fi
  # An app can't sign for a person on their own.
  status=$(mcp "$(app_token "{\"sub\": \"$human\"}")")
  if [ "$status" = 401 ]; then pass "an app-signed token for a person is refused"; else fail "a person's app-signed token: $status"; fi

  # Its check is in the decision log, as the agent acting for that person.
  local logged=0
  for _ in $(seq 1 30); do
    logged=$(curl -sf "http://localhost:8123/?user=awzy&password=awzy" \
      --data "SELECT count() FROM awzy.decisions WHERE principal_id = '$agent' AND on_behalf_of_id = '$human'" || echo 0)
    [ "${logged:-0}" -gt 0 ] && break
    sleep 2
  done
  if [ "${logged:-0}" -gt 0 ]; then pass "$agent's decisions logged for $human"; else fail "no decisions for $agent"; fi

  # Waiting on a challenge answers only the agent it was opened for: an unknown one isn't found.
  status=$(curl -s -o /dev/null -w '%{http_code}' -H "authorization: Bearer $token" \
    "http://127.0.0.1:$GATEWAY/mcp/challenges/challenge_0192a000-0000-7000-8000-000000000001?wait=0")
  if [ "$status" = 404 ]; then pass "the agent can wait on its challenges"; else fail "waiting on a challenge: $status"; fi

  # A query plan for what the agent may read, for its list tools.
  outcome=$(curl -sf "http://127.0.0.1:$PDP/v1/access/plan" -H "$(bearer $backend awzy-pdp)" \
    -H 'content-type: application/json' -d "{
    \"principal\": {\"type\": \"ServiceAccount\", \"id\": \"$agent\"}, \"on_behalf_of\": {\"type\": \"Human\", \"id\": \"$human\"},
    \"action\": \"read\", \"resource_type\": \"Resource\", \"context\": {}}" | sed -nE 's/.*"outcome": ?"([a-z_]+)".*/\1/p')
  if [ -n "$outcome" ]; then pass "a query plan for $agent ($outcome)"; else fail "no query plan"; fi

  # The same path through each client library, as the partner's app would take it.
  local lib language
  for lib in //authz/sdks/typescript:partner_e2e //authz/sdks/python:partner_e2e //authz/sdks/go/cmd/partner-e2e; do
    language=${lib#//authz/sdks/}
    language=${language%%[:/]*}
    env AWZY_TEST_PDP_URL=http://127.0.0.1:$PDP AWZY_TEST_SERVICE_TOKEN_DIR="$PWD/$state/tokens/$backend" \
      AWZY_TEST_IDP_ISSUER=$idp AWZY_TEST_IDP_JWKS_URL=$idp/jwks AWZY_TEST_CA_FILE="$ca" NODE_EXTRA_CA_CERTS="$ca" \
      AWZY_TEST_APP_NAME=$app AWZY_TEST_APP_ISSUER=$idp/apps/$app AWZY_TEST_APP_JWKS_URL=$idp/apps/$app/jwks \
      AWZY_TEST_APP_AUDIENCE=awzy-agents AWZY_TEST_AGENT_TOKEN="$token" AWZY_TEST_AGENT=$agent AWZY_TEST_HUMAN="$human" \
      AWZY_TEST_INTAKE_URL=http://127.0.0.1:$INTAKE AWZY_TEST_INTAKE_TOKEN=$intake_token \
      AWZY_TEST_SYSTEM="$app-$language" bazel run --noshow_progress "$lib" 2>"$state/logs/partner-$language.log" || failed=1
  done

  # Each library's plan results reached the events log as listed accesses, linked to their plans.
  local reported=0
  for _ in $(seq 1 30); do
    reported=$(curl -sf "http://localhost:8123/?user=awzy&password=awzy" --data "SELECT uniqExact(system) FROM awzy.events
      WHERE system LIKE '$app-%' AND access = 'listed' AND count = 3 AND attributes LIKE '%plan_%'" || echo 0)
    [ "${reported:-0}" -ge 3 ] && break
    sleep 2
  done
  if [ "${reported:-0}" -ge 3 ]; then pass "each library's plan results are in the events log"; else fail "plan results from ${reported:-0} of 3 libraries in the events log"; fi
  return $failed
}

down() {
  for f in "$state"/*.pid; do
    [ -e "$f" ] || continue
    kill "$(cat "$f")" 2>/dev/null || true
    rm -f "$f"
  done
  if [ "${1:-}" = --wipe ]; then "${compose[@]}" down -v; else "${compose[@]}" stop; fi
}

case "${1:-}" in
  up) up ;;
  check) check ;;
  partner) partner ;;
  down) shift; down "$@" ;;
  logs) ls -1 "$PWD/$state/logs/"* ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
