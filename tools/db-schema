#!/bin/sh
# Writes schema.sql next to each Postgres migrations directory: the database's schema after all of
# its migrations, to read instead of replaying them in your head. Migrations stay the source of
# truth; never edit schema.sql by hand.
#
#   tools/db-schema           regenerate every schema.sql
#   tools/db-schema --check   fail if any is out of date (CI)
#
# Needs the local stack's Postgres (docker compose -f deploy/local/compose.yaml up -d --wait).
# `--` comments in migrations don't reach schema.sql; `COMMENT ON` statements do.
set -eu
cd "$(git rev-parse --show-toplevel)"

DIRS="authz/services/policy/migrations authz/services/context/migrations portals/corp/backend/migrations portals/corp/registry/migrations"
check=false
[ "${1:-}" = "--check" ] && check=true

psql() {
  docker compose -f deploy/local/compose.yaml exec -T -e PGOPTIONS=--client-min-messages=warning postgres \
    psql -U awzy -v ON_ERROR_STOP=1 -q "$@"
}
pg_dump() { docker compose -f deploy/local/compose.yaml exec -T postgres pg_dump -U awzy "$@"; }

stale=""
for dir in $DIRS; do
  out="$(dirname "$dir")/schema.sql"
  db="schema_$(echo "$dir" | tr '/-' '__' | tr -cd 'a-z0-9_')"
  psql -d postgres -c "DROP DATABASE IF EXISTS $db" -c "CREATE DATABASE $db"
  for f in $(ls "$dir"/*.sql | sort); do
    psql -d "$db" < "$f"
  done
  tmp=$(mktemp)
  {
    echo "-- The schema after every migration in $dir, generated by tools/db-schema."
    echo "-- Read it; don't edit it: change the schema with a new migration, then run tools/db-schema."
    # Drop what varies by machine or run: session settings, pg_dump's version banner, and the
    # random \restrict key newer pg_dump versions write.
    pg_dump --schema-only --no-owner --no-privileges --no-tablespaces "$db" \
      | grep -vE '^(SET |SELECT pg_catalog\.set_config|\\(un)?restrict |-- Dumped (from|by) )' \
      | sed -e '/^--$/d' -e '/^-- PostgreSQL database dump/d' -e '/^-- Name: .*; Type: .*; Schema: .*; Owner: /d' \
      | cat -s
  } > "$tmp"
  psql -d postgres -c "DROP DATABASE $db"
  if $check; then
    if ! cmp -s "$tmp" "$out"; then
      stale="$stale $out"
      diff -u "$out" "$tmp" || true
    fi
    rm -f "$tmp"
  else
    mv "$tmp" "$out"
    echo "wrote $out"
  fi
done

if [ -n "$stale" ]; then
  echo "db-schema: out of date:$stale. Run tools/db-schema and commit the result." >&2
  exit 1
fi
