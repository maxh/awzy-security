#!/bin/sh
# Git merge driver for the lockfiles Bazel's crate_universe generates (MODULE.bazel.lock,
# Cargo.lock). Merging them by hand is error-prone and both are reproducible, so on a conflict it
# keeps the side being merged onto (main, during a rebase) and leaves a note; the post-rewrite and
# post-merge hooks then re-pin from every Cargo.toml and commit the result.
#
# Registered by tools/git-setup (pnpm install runs it):
#   git config merge.awzy-lockfile.driver 'tools/git-merge-lockfile %O %A %B %P'
#
# Arguments: ancestor, current (the result goes here), other, path.
set -eu
current=$2
path=$4
# Keep $current as it is; note that the lockfiles need re-pinning.
echo "$path" >> "$(git rev-parse --git-dir)/awzy-repin-needed"
echo "git-merge-lockfile: kept the current $path; the lockfiles are re-pinned when the rebase or merge finishes." >&2
exit 0
