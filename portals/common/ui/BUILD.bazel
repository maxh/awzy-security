load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//portals/common/ui:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages()

# Linked into the portals as @awzy/ui; Vite compiles the TypeScript sources directly.
npm_package(
    name = "pkg",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"], allow_empty = True) + [
        "package.json",
        ":node_modules",
    ],
    visibility = ["//visibility:public"],
)

# The unit tests (`*.test.ts`), with Vitest (#226), unsandboxed like the portals' builds.
vitest_bin.vitest_test(
    name = "unit",
    size = "small",
    args = ["run"],
    chdir = package_name(),
    data = glob(["src/**/*.ts", "src/**/*.tsx"]) + [
        "package.json",
        ":node_modules",
    ],
    tags = ["no-sandbox"],
)
