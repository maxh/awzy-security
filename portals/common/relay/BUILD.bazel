load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages()

# Linked into the portals as @awzy/relay; Vite compiles the TypeScript sources directly.
npm_package(
    name = "pkg",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"], allow_empty = True) + [
        "package.json",
        ":node_modules",
    ],
    visibility = ["//visibility:public"],
)

# Each frontend's `relay` target (ADR 0090).
copy_to_bin(
    name = "generate",
    srcs = ["generate.mjs"],
    visibility = ["//portals:__subpackages__"],
)
