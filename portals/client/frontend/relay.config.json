{
  "src": "./src",
  "schema": "./schema.graphql",
  "language": "typescript",
  "eagerEsModules": true,
  "excludes": [
    "**/node_modules/**",
    "**/__generated__/**"
  ],
  "customScalarTypes": {
    "Qid": "string",
    "UtcTimestamp": "string"
  },
  "persistConfig": {
    "file": "./persisted_queries.json",
    "algorithm": "SHA256",
    "include_query_text": true
  }
}
