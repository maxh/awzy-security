module(name = "awzy", version = "0.1.0")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # Service images are Linux; developers build them from macOS.
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Zig-based C toolchain used only to link Linux binaries. Builds for the host
# platform keep using the local C toolchain.
zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.31",
)

# Base image for every service: glibc + CA certificates, no shell, runs as nonroot.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc",
    digest = "sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f",
    image = "gcr.io/distroless/cc-debian12",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "distroless_cc", "distroless_cc_linux_amd64", "distroless_cc_linux_arm64_v8")

# Third-party Rust crates come from Cargo.toml / Cargo.lock so cargo tooling keeps working.
# crate_universe keeps what it resolved in cargo-bazel-lock.json, one entry per crate, rather than
# as one large entry in MODULE.bazel.lock that every Cargo.toml change rewrites: with both lockfiles
# set, the extension is reproducible and Bazel leaves it out of MODULE.bazel.lock.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
    # Only the platforms awzy builds for: Linux images (amd64, arm64) and macOS hosts. Fewer
    # triples keep other platforms' dependencies (Windows, Android, ...) out of the lockfile;
    # building for one not listed fails at analysis, so add it here first.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# ---- TypeScript portals
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.13.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "9.15.9",
)
use_repo(pnpm, "pnpm", "pnpm__links")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    bins = {
        "relay-compiler": ["relay-compiler=./cli.js"],
        "typescript": ["tsc=./bin/tsc"],
        "vite": ["vite=./bin/vite.js"],
    },
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
        "//portals/client/e2e:package.json",
        "//portals/client/frontend:package.json",
        "//portals/corp/frontend:package.json",
        "//portals/common/relay:package.json",
        "//portals/common/ui:package.json",
    ],
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")
