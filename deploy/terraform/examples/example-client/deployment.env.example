# Inputs for deploy/terraform/examples/example-client/*: copy to deployment.env (gitignored),
# fill in, and `source` it before running tofu in any module there.

export TF_VAR_acme_email=admin@example.com
# Cluster admins besides CI's apply role; `operator` is whoever created the cluster (its IAM
# Identity Center role, from `aws sts get-caller-identity`, as arn:aws:iam::<id>:role/aws-reserved/...).
export TF_VAR_cluster_admins='{ operator = "arn:aws:iam::444444444444:role/aws-reserved/sso.amazonaws.com/us-east-2/AWSReservedSSO_AdministratorAccess_0123456789abcdef" }'
export TF_VAR_github_oidc_subject_repo=example-owner@1234567/example-repo@7654321
export TF_VAR_demo_hostname=aws.demo.example.com
export TF_VAR_demo_redirect_hostnames='["demo.example.com"]'
# IAM Identity Center user IDs who administer the install's Grafana (monitoring/). CI applies
# monitoring/ from this file, so leaving it out removes them.
export TF_VAR_grafana_admin_user_ids='["00000000-0000-0000-0000-000000000000"]'
export TF_VAR_install_account='{ name = "example-install", email = "aws-example-install@example.com" }'
export TF_VAR_install_account_id=444444444444
export TF_VAR_install_profile=example-client-install
export TF_VAR_management_account_id=333333333333
export TF_VAR_management_profile=example-client
export TF_VAR_region=us-east-2
export TF_VAR_registry_prefix=registry.example.com/awzy
export TF_VAR_state_bucket=example-client-terraform-state-333333333333
# Investigations' model, on the Google Cloud demo's Vertex AI: an API key bound to a service
# account there with roles/aiplatform.user (`gcloud services api-keys create --service-account=…`).
export TF_VAR_vertex_project=example-gcp-project
export TF_VAR_vertex_api_key=

# The state backend can't read variables, so `tofu init` gets them as arguments.
export TF_CLI_ARGS_init="-backend-config=bucket=$TF_VAR_state_bucket -backend-config=region=$TF_VAR_region -backend-config=profile=$TF_VAR_management_profile"
