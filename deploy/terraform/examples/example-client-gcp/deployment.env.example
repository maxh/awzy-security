# Inputs for deploy/terraform/examples/example-client-gcp/*: copy to deployment.env (gitignored),
# fill in, and `source` it before running tofu in any module there.

export TF_VAR_project=example-client-gcp
export TF_VAR_region=us-central1
export TF_VAR_zone=us-central1-a
export TF_VAR_state_bucket=example-client-gcp-terraform-state
export TF_VAR_registry_prefix=registry.example.com/awzy
export TF_VAR_demo_hostname=gcp.demo.example.com
export TF_VAR_acme_email=admin@example.com
# GitHub's immutable OIDC subject for the repository whose CI applies these modules (ADR 0115):
# `gh api repos/{owner}/{repo}/actions/oidc/customization/sub` shows it, after `repo:`.
export TF_VAR_github_oidc_subject_repo=example-owner@1234567/example-repo@7654321

# The state backend can't read variables, so `tofu init` gets them as arguments.
export TF_CLI_ARGS_init="-backend-config=bucket=$TF_VAR_state_bucket"
