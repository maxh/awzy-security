# Inputs for deploy/terraform/corp/*: copy to deployment.env (gitignored), fill in, and
# `source deploy/terraform/corp/deployment.env` before running tofu in any module there.

export TF_VAR_build_account_id=222222222222
export TF_VAR_build_profile=my-org-build
export TF_VAR_build_state_bucket=my-org-terraform-state-222222222222
export TF_VAR_cloudflare_zone_id=0123456789abcdef0123456789abcdef
export TF_VAR_domain=example.com
# From `gh api repos/OWNER/REPO --jq '"\(.owner.login)@\(.owner.id)/\(.name)@\(.id)"'`.
export TF_VAR_github_oidc_subject_repo='owner@12345/repo@67890'
export TF_VAR_management_account_id=111111111111
export TF_VAR_management_profile=my-org-management
export TF_VAR_member_accounts='{ build = { name = "my-build", email = "aws-build@example.com" } }'
export TF_VAR_region=us-east-2
export TF_VAR_state_bucket=my-org-terraform-state-111111111111
