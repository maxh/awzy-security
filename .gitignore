/bazel-*
.bazelrc.user
/target/
node_modules/
dist/
.DS_Store
rust-project.json

# OpenTofu / Terraform
.terraform/
*.tfstate
*.tfstate.*
# Saved plans hold a copy of the state, with every account ID and ARN in it.
*.plan
*.tfplan
/.dev-certs/

# Per-deployment Terraform inputs (account IDs, buckets, emails): see deployment.env.example.
deploy/terraform/**/deployment.env

# Credentials for trying the Drive and Jira connectors locally (ADR 0069, 0070).
drive-key.json
jira-token

# Relay's output: `pnpm relay` and the frontends' Bazel `relay` targets generate it (ADR 0090).
__generated__/
portals/*/frontend/persisted_queries.json

# tools/demo: its logs, pids, and the dev IdP's certificate.
/.demo/
